@model IEnumerable<CRM_Project.Models.Employee>
@{
    ViewData["Title"] = "Employees";
}

<div class="page-header d-flex justify-content-between align-items-center">
    <h3><i class="bi bi-person-workspace text-info me-2"></i>Employees</h3>
    <a href="/BuildingOwner/CreateEmployee" class="btn btn-info text-white btn-sm">
        <i class="bi bi-person-badge me-1"></i>Add Employee
    </a>
</div>

<div class="card">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Name</th>
                        <th>Username</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>Building</th>
                        <th>Joined</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var e in Model)
                    {
                        <tr>
                            <td><strong>@e.FirstName @e.LastName</strong></td>
                            <td><code>@e.Username</code></td>
                            <td>@e.Email</td>
                            <td>@e.Phone</td>
                            <td>@e.Building?.BuildingName</td>
                            <td>@e.CreatedDate.ToString("MM/dd/yyyy")</td>
                            <td class="text-center">
                                <div class="d-flex gap-1 justify-content-center">
                                    <a href="/BuildingOwner/EmployeeDetails/@e.EmployeeId"
                                       class="btn btn-sm btn-outline-info" title="View Details">
                                        <i class="bi bi-eye">View</i>
                                    </a>
                                    <a href="/BuildingOwner/EditEmployee/@e.EmployeeId"
                                       class="btn btn-sm btn-outline-warning" title="Edit">
                                        <i class="bi bi-pencil">Edit</i>
                                    </a>
                                    <form method="post" action="/BuildingOwner/DeleteEmployee"
                                          onsubmit="return confirm('Delete employee @e.FirstName @e.LastName?')">
                                        <input type="hidden" name="id" value="@e.EmployeeId" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete">
                                            <i class="bi bi-trash">Delete</i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-4">No employees registered yet.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
