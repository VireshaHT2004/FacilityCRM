@model IEnumerable<CRM_Project.Models.Customer>
@{
    ViewData["Title"] = "Customers";
}

<div class="page-header d-flex justify-content-between align-items-center">
    <h3><i class="bi bi-people text-success me-2"></i>Customers</h3>
    <a href="/BuildingOwner/CreateCustomer" class="btn btn-success btn-sm">
        <i class="bi bi-person-plus me-1"></i>Add Customer
    </a>
</div>

<div class="card">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Name</th>
                        <th>Title</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>Building</th>
                        <th>Floor</th>
                        <th>Joined</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model)
                    {
                        <tr>
                            <td><strong>@c.FirstName @c.LastName</strong></td>
                            <td>@c.Title</td>
                            <td>@c.Email</td>
                            <td>@c.PhoneNumber</td>
                            <td>@c.Building?.BuildingName</td>
                            <td>
                                @if (c.FloorAssignment != null)
                                {
                                    <span class="badge bg-primary">Floor @c.FloorAssignment.FloorNumber</span>
                                }
                            </td>
                            <td>@c.CreatedDate.ToString("MM/dd/yyyy")</td>
                            <td class="text-center">
                                <div class="d-flex gap-1 justify-content-center">
                                    <a href="/BuildingOwner/CustomerDetails/@c.CustomerId"
                                       class="btn btn-sm btn-outline-info" title="View Details">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a href="/BuildingOwner/EditCustomer/@c.CustomerId"
                                       class="btn btn-sm btn-outline-warning" title="Edit">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <form method="post" action="/BuildingOwner/DeleteCustomer"
                                          onsubmit="return confirm('Delete @c.FirstName @c.LastName? This will also delete their login account.')">
                                        <input type="hidden" name="id" value="@c.CustomerId" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center text-muted py-4">No customers registered yet.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
