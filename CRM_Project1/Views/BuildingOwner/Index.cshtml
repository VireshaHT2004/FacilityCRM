@{
    ViewData["Title"] = "Building Owner Dashboard";

    var customers = ViewBag.Customers as List<CRM_Project.Models.Customer> ?? new();
    var employees = ViewBag.Employees as List<CRM_Project.Models.Employee> ?? new();
    var recentRequests = ViewBag.RecentRequests as List<CRM_Project.Models.CustomerServiceRequest> ?? new();
}

<div class="page-header">
    <h3>
        <i class="bi bi-speedometer2 text-success me-2"></i>
        Building Owner Dashboard
    </h3>

    <!-- JWT username -->
    <p class="text-muted">Welcome, @User.Identity?.Name</p>
</div>


<!-- STATISTICS CARDS -->

<div class="row g-3 mb-4">

    <div class="col-md-3">
        <div class="card stat-card border-success p-3">
            <div class="d-flex align-items-center">
                <div class="flex-grow-1">
                    <div class="text-muted small">Customers</div>
                    <div class="fs-2 fw-bold text-success">@customers.Count</div>
                </div>

                <i class="bi bi-people fs-1 text-success opacity-25"></i>
            </div>
        </div>
    </div>


    <div class="col-md-3">
        <div class="card stat-card border-info p-3">
            <div class="d-flex align-items-center">
                <div class="flex-grow-1">
                    <div class="text-muted small">Employees</div>
                    <div class="fs-2 fw-bold text-info">@employees.Count</div>
                </div>

                <i class="bi bi-person-workspace fs-1 text-info opacity-25"></i>
            </div>
        </div>
    </div>


    <div class="col-md-3">
        <div class="card stat-card border-warning p-3">
            <div class="d-flex align-items-center">
                <div class="flex-grow-1">
                    <div class="text-muted small">Pending Requests</div>
                    <div class="fs-2 fw-bold text-warning">
                        @recentRequests.Count(r => r.Status == "Pending")
                    </div>
                </div>

                <i class="bi bi-hourglass-split fs-1 text-warning opacity-25"></i>
            </div>
        </div>
    </div>


    <div class="col-md-3">
        <div class="card stat-card border-danger p-3">
            <div class="d-flex align-items-center">
                <div class="flex-grow-1">
                    <div class="text-muted small">Total Requests</div>
                    <div class="fs-2 fw-bold text-danger">@recentRequests.Count</div>
                </div>

                <i class="bi bi-clipboard-check fs-1 text-danger opacity-25"></i>
            </div>
        </div>
    </div>

</div>


<!-- ACTION BUTTONS -->

<div class="row g-3 mb-4">

    <div class="col-md-4">
        <a href="/BuildingOwner/CreateCustomer"
           class="btn btn-success w-100 py-3">

            <i class="bi bi-person-plus fs-4 d-block mb-1"></i>

            Register Customer
        </a>
    </div>


    <div class="col-md-4">
        <a href="/BuildingOwner/CreateEmployee"
           class="btn btn-info w-100 py-3 text-white">

            <i class="bi bi-person-badge fs-4 d-block mb-1"></i>

            Register Employee
        </a>
    </div>


    <div class="col-md-4">
        <a href="/OwnerService/ServiceRequests"
           class="btn btn-warning w-100 py-3 text-dark">

            <i class="bi bi-clipboard-check fs-4 d-block mb-1"></i>

            Service Requests
        </a>
    </div>

</div>


<!-- RECENT REQUEST TABLE -->

<div class="card">

    <div class="card-header bg-white">
        <h6 class="mb-0 fw-bold">Recent Service Requests</h6>
    </div>

    <div class="card-body p-0">

        <div class="table-responsive">

            <table class="table table-hover mb-0">

                <thead class="table-light">
                    <tr>
                        <th>#</th>
                        <th>Customer</th>
                        <th>Service</th>
                        <th>Priority</th>
                        <th>Status</th>
                        <th>Date</th>
                        <th>Action</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var r in recentRequests)
                    {
                        <tr>

                            <td>#@r.RequestId</td>

                            <td>
                                @r.Customer?.FirstName
                                @r.Customer?.LastName
                            </td>

                            <td>@r.Service?.ServiceName</td>

                            <td>
                                <span class="priority-@r.Priority">
                                    @r.Priority
                                </span>
                            </td>

                            <td>
                                <span class="badge badge-status-@r.Status">
                                    @r.Status
                                </span>
                            </td>

                            <td>
                                @r.RequestDate.ToString("MM/dd/yyyy")
                            </td>

                            <td>

                                @if (r.Status == "Pending")
                                {
                                    <a href="/OwnerService/AssignService/@r.RequestId"
                                       class="btn btn-sm btn-primary">

                                        Assign
                                    </a>
                                }

                            </td>

                        </tr>
                    }

                    @if (!recentRequests.Any())
                    {
                        <tr>
                            <td colspan="7"
                                class="text-center text-muted py-4">

                                No service requests yet.

                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>