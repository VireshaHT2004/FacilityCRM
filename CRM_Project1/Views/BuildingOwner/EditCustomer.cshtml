@model CRM_Project.Models.Customer
@{ViewData["Title"] = "Edit Customer";}

<div class="page-header d-flex justify-content-between align-items-center">
    <h3 class="mb-0"><i class="bi bi-pencil-square text-warning me-2"></i>Edit Customer</h3>
    <a href="/BuildingOwner/Customers" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Back</a>
</div>

<div class="row">
    <div class="col-md-7">
        <div class="card">
            <div class="card-header bg-warning text-dark">
                <h6 class="mb-0 fw-bold">Editing: @Model.FirstName @Model.LastName</h6>
            </div>
            <div class="card-body">
                <form method="post" action="/BuildingOwner/EditCustomer">
                    <input type="hidden" name="customerId" value="@Model.CustomerId" />
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">First Name *</label>
                            <input name="firstName" class="form-control" value="@Model.FirstName" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Last Name *</label>
                            <input name="lastName" class="form-control" value="@Model.LastName" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Email</label>
                            <input name="email" class="form-control" type="email" value="@Model.Email" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Phone</label>
                            <input name="phoneNumber" class="form-control" value="@Model.PhoneNumber" />
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold">Title</label>
                            <input name="title" class="form-control" value="@Model.Title" />
                        </div>
                    </div>
                    <hr class="my-3" />
                    <h6 class="text-muted mb-1">Building & Floor <span class="badge bg-secondary">Read Only</span></h6>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <input class="form-control" value="@Model.Building?.BuildingName" disabled />
                        </div>
                        <div class="col-md-6">
                            <input class="form-control" value="Floor @Model.FloorAssignment?.FloorNumber" disabled />
                        </div>
                    </div>
                    <hr class="my-3" />
                    <h6 class="text-muted mb-1">Change Password</h6>
                    <p class="text-muted small mb-2">Leave blank to keep current password.</p>
                    <div class="col-md-6">
                        <input name="newPassword" class="form-control" type="password" placeholder="New password" />
                    </div>
                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn btn-warning px-4">
                            <i class="bi bi-save me-1"></i>Save Changes
                        </button>
                        <a href="/BuildingOwner/CustomerDetails/@Model.CustomerId" class="btn btn-outline-info">
                            <i class="bi bi-eye me-1"></i>View Details
                        </a>
                        <a href="/BuildingOwner/Customers" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-warning">
            <div class="card-header bg-warning text-dark"><h6 class="mb-0">Note</h6></div>
            <div class="card-body">
                <p class="small text-muted mb-1">Building and floor cannot be changed here.</p>
                <p class="small text-muted mb-0">Password only updates if a new value is entered.</p>
            </div>
        </div>
    </div>
</div>
