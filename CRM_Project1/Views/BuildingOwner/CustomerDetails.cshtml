@model CRM_Project.Models.Customer
@{ViewData["Title"] = "Customer Details";}

<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h3 class="mb-0"><i class="bi bi-person-circle text-info me-2"></i>Customer Details</h3>
        <p class="text-muted mb-0">Full profile and service history</p>
    </div>
    <div class="d-flex gap-2">
        <a href="/BuildingOwner/EditCustomer/@Model.CustomerId" class="btn btn-warning">
            <i class="bi bi-pencil me-1"></i>Edit
        </a>
        <a href="/BuildingOwner/Customers" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>Back
        </a>
    </div>
</div>

<div class="row g-3">
    <div class="col-md-4">
        <div class="card mb-3">
            <div class="card-body text-center pb-2">
                <div class="rounded-circle bg-success text-white d-flex align-items-center justify-content-center mx-auto mb-3"
                     style="width:72px;height:72px;font-size:1.6rem;font-weight:700;">
                    @Model.FirstName.FirstOrDefault()@Model.LastName.FirstOrDefault()
                </div>
                <h5 class="mb-1">@Model.FirstName @Model.LastName</h5>
                <p class="text-muted small mb-2">@Model.Title</p>
                <span class="badge bg-success">Customer</span>
            </div>
            <ul class="list-group list-group-flush">
                <li class="list-group-item d-flex justify-content-between">
                    <span class="text-muted small">Username</span><code>@Model.User?.Username</code>
                </li>
                <li class="list-group-item d-flex justify-content-between">
                    <span class="text-muted small">Email</span><span>@Model.Email</span>
                </li>
                <li class="list-group-item d-flex justify-content-between">
                    <span class="text-muted small">Phone</span><span>@Model.PhoneNumber</span>
                </li>
                <li class="list-group-item d-flex justify-content-between">
                    <span class="text-muted small">Building</span><span>@Model.Building?.BuildingName</span>
                </li>
                <li class="list-group-item d-flex justify-content-between">
                    <span class="text-muted small">Floor</span>
                    @if (Model.FloorAssignment != null)
                    { <span class="badge bg-primary">Floor @Model.FloorAssignment.FloorNumber</span> }
                    else { <span class="text-muted">—</span> }
                </li>
                <li class="list-group-item d-flex justify-content-between">
                    <span class="text-muted small">Registered</span><span>@Model.CreatedDate.ToString("MMM dd, yyyy")</span>
                </li>
            </ul>
        </div>

        <div class="card">
            <div class="card-header bg-light"><h6 class="mb-0 fw-bold">Request Summary</h6></div>
            <div class="card-body">
                <div class="d-flex justify-content-between py-1 border-bottom">
                    <span class="text-muted">Total</span><strong>@Model.ServiceRequests.Count</strong>
                </div>
                <div class="d-flex justify-content-between py-1 border-bottom">
                    <span class="text-muted">Pending</span>
                    <span class="badge bg-warning">@Model.ServiceRequests.Count(r => r.Status == "Pending")</span>
                </div>
                <div class="d-flex justify-content-between py-1 border-bottom">
                    <span class="text-muted">In Progress</span>
                    <span class="badge bg-info">@Model.ServiceRequests.Count(r => r.Status is "Assigned" or "Accepted" or "Travelling" or "WorkStarted")</span>
                </div>
                <div class="d-flex justify-content-between py-1">
                    <span class="text-muted">Completed</span>
                    <span class="badge bg-success">@Model.ServiceRequests.Count(r => r.Status == "Completed")</span>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-8">
        <div class="card">
            <div class="card-header bg-white">
                <h6 class="mb-0 fw-bold"><i class="bi bi-clipboard-check me-1"></i>Service Request History</h6>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr><th>#</th><th>Service</th><th>Priority</th><th>Status</th><th>Date</th><th>Est. Cost</th><th>Est. Time</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var r in Model.ServiceRequests.OrderByDescending(r => r.RequestDate))
                            {
                                <tr>
                                    <td>#@r.RequestId</td>
                                    <td>@r.Service?.ServiceName</td>
                                    <td><span class="priority-@r.Priority">@r.Priority</span></td>
                                    <td><span class="badge badge-status-@r.Status text-white">@r.Status</span></td>
                                    <td>@r.RequestDate.ToString("MM/dd/yyyy")</td>
                                    <td>@(r.EstimatedCost.HasValue ? "$" + r.EstimatedCost.Value.ToString("F2") : "—")</td>
                                    <td>@(r.EstimatedTime ?? "—")</td>
                                </tr>
                            }
                            @if (!Model.ServiceRequests.Any())
                            { <tr><td colspan="7" class="text-center text-muted py-3">No service requests yet.</td></tr> }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
