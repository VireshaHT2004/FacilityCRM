@model CRM_Project.Models.Employee
@{
    ViewData["Title"] = "Employee Details";
    var assignments = Model.Assignments?.ToList() ?? new();
}

<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h3 class="mb-0"><i class="bi bi-person-badge text-info me-2"></i>Employee Details</h3>
        <p class="text-muted mb-0">Full profile and assignment history</p>
    </div>
    <div class="d-flex gap-2">
        <a href="/BuildingOwner/EditEmployee/@Model.EmployeeId" class="btn btn-warning">
            <i class="bi bi-pencil me-1"></i>Edit
        </a>
        <a href="/BuildingOwner/Employees" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>Back
        </a>
    </div>
</div>

<div class="row g-3">
    <div class="col-md-4">
        <div class="card">
            <div class="card-body text-center pb-2">
                <div class="rounded-circle bg-info text-white d-flex align-items-center justify-content-center mx-auto mb-3"
                     style="width:72px;height:72px;font-size:1.6rem;font-weight:700;">
                    @Model.FirstName.FirstOrDefault()@Model.LastName.FirstOrDefault()
                </div>
                <h5 class="mb-1">@Model.FirstName @Model.LastName</h5>
                <p class="text-muted small mb-2">@Model.Building?.BuildingName</p>
                <span class="badge bg-info">Employee</span>
            </div>
            <ul class="list-group list-group-flush">
                <li class="list-group-item d-flex justify-content-between">
                    <span class="text-muted small">Username</span><code>@Model.Username</code>
                </li>
                <li class="list-group-item d-flex justify-content-between">
                    <span class="text-muted small">Email</span><span>@Model.Email</span>
                </li>
                <li class="list-group-item d-flex justify-content-between">
                    <span class="text-muted small">Phone</span><span>@Model.Phone</span>
                </li>
                <li class="list-group-item d-flex justify-content-between">
                    <span class="text-muted small">Registered</span><span>@Model.CreatedDate.ToString("MMM dd, yyyy")</span>
                </li>
            </ul>
        </div>
    </div>

    <div class="col-md-8">
        <div class="row g-3 mb-3">
            <div class="col-md-3">
                <div class="card p-3 text-center stat-card border-info">
                    <div class="text-muted small">Total Jobs</div>
                    <div class="fs-2 fw-bold text-info">@assignments.Count</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card p-3 text-center stat-card border-warning">
                    <div class="text-muted small">Pending</div>
                    <div class="fs-2 fw-bold text-warning">@assignments.Count(a => a.EmployeeStatus == "Pending")</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card p-3 text-center stat-card border-success">
                    <div class="text-muted small">Accepted</div>
                    <div class="fs-2 fw-bold text-success">@assignments.Count(a => a.EmployeeStatus == "Accepted")</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card p-3 text-center stat-card border-danger">
                    <div class="text-muted small">Rejected</div>
                    <div class="fs-2 fw-bold text-danger">@assignments.Count(a => a.EmployeeStatus == "Rejected")</div>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-header bg-white"><h6 class="mb-0 fw-bold">Assignment History</h6></div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr><th>Request #</th><th>Service</th><th>Priority</th><th>Job Status</th><th>Response</th><th>Assigned</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var a in assignments.OrderByDescending(a => a.AssignedDate))
                            {
                                <tr>
                                    <td>#@a.RequestId</td>
                                    <td>@a.Request?.Service?.ServiceName</td>
                                    <td><span class="priority-@a.Request?.Priority">@a.Request?.Priority</span></td>
                                    <td><span class="badge badge-status-@a.Request?.Status text-white">@a.Request?.Status</span></td>
                                    <td>
                                        <span class="badge @(a.EmployeeStatus == "Accepted" ? "bg-success" : a.EmployeeStatus == "Rejected" ? "bg-danger" : "bg-secondary")">
                                            @a.EmployeeStatus
                                        </span>
                                    </td>
                                    <td>@a.AssignedDate.ToString("MM/dd/yyyy")</td>
                                </tr>
                            }
                            @if (!assignments.Any())
                            { <tr><td colspan="6" class="text-center text-muted py-3">No assignments yet.</td></tr> }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
