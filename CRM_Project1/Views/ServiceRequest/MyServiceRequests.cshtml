@model IEnumerable<CRM_Project.Models.CustomerServiceRequest>
@{
    ViewData["Title"] = "My Service Requests";
}

<div class="page-header d-flex justify-content-between align-items-center">
    <h3><i class="bi bi-list-check text-primary me-2"></i>My Service Requests</h3>
    <a href="/ServiceRequest/CreateServiceRequest" class="btn btn-primary btn-sm">
        <i class="bi bi-plus me-1"></i>New Request
    </a>
</div>

<div class="card">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>#</th>
                        <th>Service</th>
                        <th>Building</th>
                        <th>Floor</th>
                        <th>Priority</th>
                        <th>Status</th>
                        <th>Date</th>
                        <th>Est. Cost</th>
                        <th>Est. Time</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model)
                    {
                        <tr>
                            <td class="text-muted">#@r.RequestId</td>
                            <td><strong>@r.Service?.ServiceName</strong></td>
                            <td>@r.Building?.BuildingName</td>
                            <td>Floor @r.FloorNumber</td>
                            <td><span class="priority-@r.Priority">@r.Priority</span></td>
                            <td>
                                <span class="badge badge-status-@r.Status text-white">@r.Status</span>
                            </td>
                            <td>@r.RequestDate.ToString("MM/dd/yy HH:mm")</td>
                            <td>@(r.EstimatedCost.HasValue ? "$" + r.EstimatedCost.Value.ToString("F2") : "-")</td>
                            <td>@(r.EstimatedTime ?? "-")</td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="9" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                                No service requests yet. <a href="/ServiceRequest/CreateServiceRequest">Create one now</a>.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
