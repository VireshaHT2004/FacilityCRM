@{
    ViewData["Title"] = "New Service Request";
}

<div class="page-header">
    <h3><i class="bi bi-plus-circle text-primary me-2"></i>New Service Request</h3>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header bg-primary text-white">
                <h6 class="mb-0">Submit a Service Request</h6>
            </div>
            <div class="card-body">
                <form method="post" action="/ServiceRequest/CreateServiceRequest">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Service Type *</label>
                        <select name="serviceId" class="form-select" required>
                            <option value="">-- Select Service --</option>
                            @foreach (var item in (ViewBag.Services as Microsoft.AspNetCore.Mvc.Rendering.SelectList ?? new Microsoft.AspNetCore.Mvc.Rendering.SelectList(new List<object>())))
                            {
                                <option value="@item.Value">@item.Text</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Priority *</label>
                        <div class="d-flex gap-3">
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="priority" value="Low" id="pLow" />
                                <label class="form-check-label text-success" for="pLow">Low</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="priority" value="Normal" id="pNormal" checked />
                                <label class="form-check-label text-primary" for="pNormal">Normal</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="priority" value="High" id="pHigh" />
                                <label class="form-check-label text-danger" for="pHigh">High</label>
                            </div>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Details / Description</label>
                        <textarea name="details" class="form-control" rows="4"
                            placeholder="Describe your service request..."></textarea>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary px-4">
                            <i class="bi bi-send me-1"></i>Submit Request
                        </button>
                        <a href="/Customer/Index" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-info">
            <div class="card-header bg-info text-white">
                <h6 class="mb-0"><i class="bi bi-info-circle me-1"></i>Info</h6>
            </div>
            <div class="card-body">
                <p class="small text-muted">Your building and floor information will be automatically attached to this request.</p>
                <p class="small text-muted">A building owner will review and assign an employee to handle your request.</p>
                <p class="small text-muted mb-0">You can track the status of your requests from <strong>My Requests</strong>.</p>
            </div>
        </div>
    </div>
</div>
