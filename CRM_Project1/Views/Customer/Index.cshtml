@{
    ViewData["Title"] = "Customer Dashboard";
    var customer = ViewBag.Customer as CRM_Project.Models.Customer;
    var requests = ViewBag.Requests as List<CRM_Project.Models.CustomerServiceRequest> ?? new();
}

<div class="page-header">
    <h3><i class="bi bi-speedometer2 text-primary me-2"></i>Customer Dashboard</h3>
    <p class="text-muted">Welcome, @customer?.FirstName @customer?.LastName</p>
</div>

<div class="row g-3 mb-4">
    <!-- Building Info Card -->
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-header bg-primary text-white">
                <h6 class="mb-0"><i class="bi bi-building me-1"></i>Building Information</h6>
            </div>
            <div class="card-body">
                <p class="mb-1"><strong>@customer?.Building?.BuildingName</strong></p>
                <p class="text-muted small mb-1">@customer?.Building?.StreetAddress</p>
                <p class="text-muted small mb-1">@customer?.Building?.City, @customer?.Building?.State</p>
                <p class="text-muted small mb-0">@customer?.Building?.Country @customer?.Building?.PostalCode</p>
            </div>
        </div>
    </div>

    <!-- Floor Info Card -->
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-header bg-success text-white">
                <h6 class="mb-0"><i class="bi bi-layers me-1"></i>Floor Information</h6>
            </div>
            <div class="card-body d-flex align-items-center justify-content-center">
                @if (customer?.FloorAssignment != null)
                {
                    <div class="text-center">
                        <div class="display-4 fw-bold text-success">@customer.FloorAssignment.FloorNumber</div>
                        <div class="text-muted">Your Floor</div>
                    </div>
                }
                else
                {
                    <p class="text-muted">No floor assigned.</p>
                }
            </div>
        </div>
    </div>

    <!-- Service Requests Summary -->
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-header bg-warning text-dark">
                <h6 class="mb-0"><i class="bi bi-clipboard-check me-1"></i>Service Requests</h6>
            </div>
            <div class="card-body">
                <div class="d-flex justify-content-between mb-2">
                    <span>Total</span><strong>@requests.Count</strong>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span>Pending</span><span class="badge bg-warning">@requests.Count(r => r.Status == "Pending")</span>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span>In Progress</span><span class="badge bg-info">@requests.Count(r => r.Status is "Assigned" or "Accepted" or "Travelling" or "WorkStarted")</span>
                </div>
                <div class="d-flex justify-content-between">
                    <span>Completed</span><span class="badge bg-success">@requests.Count(r => r.Status == "Completed")</span>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="d-flex gap-2 mb-3">
    <a href="/ServiceRequest/CreateServiceRequest" class="btn btn-primary">
        <i class="bi bi-plus-circle me-1"></i>New Service Request
    </a>
    <a href="/ServiceRequest/MyServiceRequests" class="btn btn-outline-primary">
        <i class="bi bi-list-check me-1"></i>View All Requests
    </a>
</div>

@if (requests.Any())
{
    <div class="card">
        <div class="card-header bg-white">
            <h6 class="mb-0 fw-bold">Recent Requests</h6>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Service</th>
                            <th>Priority</th>
                            <th>Status</th>
                            <th>Date</th>
                            <th>Est. Cost</th>
                            <th>Est. Time</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in requests.Take(5))
                        {
                            <tr>
                                <td>@r.Service?.ServiceName</td>
                                <td><span class="priority-@r.Priority">@r.Priority</span></td>
                            <td>
                                <span class="badge badge-status-@r.Status">@r.Status</span>
                                @if (r.WorkUpdates != null && r.WorkUpdates.Any())
                                {
                                    <div class="small text-muted mt-1">Last: @r.WorkUpdates.OrderByDescending(w => w.UpdateTime).First().WorkStatus</div>
                                }
                            </td>
                                <td>@r.RequestDate.ToString("MM/dd/yyyy")</td>
                                <td>@(r.EstimatedCost.HasValue ? "$" + r.EstimatedCost.Value.ToString("F2") : "-")</td>
                                <td>@(r.EstimatedTime ?? "-")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
