@{
    ViewData["Title"] = "Update Service Status";
    var request = ViewBag.Request as CRM_Project.Models.CustomerServiceRequest;
    var workUpdates = ViewBag.WorkUpdates as List<CRM_Project.Models.ServiceWorkUpdate> ?? new();
}

<div class="page-header mb-3">
    <h3>
        <i class="bi bi-arrow-up-circle text-primary me-2"></i>
        Update Service Status
    </h3>
</div>

<div class="row">

    <!-- REQUEST DETAILS -->
    <div class="col-md-4">
        <div class="card mb-3 shadow-sm">
            <div class="card-header bg-light">
                <h6 class="mb-0 fw-bold">Request Details</h6>
            </div>

            <div class="card-body">

                <p><strong>Request #:</strong> @request?.RequestId</p>

                <p><strong>Service:</strong>
                    @request?.Service?.ServiceName
                </p>

                <p><strong>Customer:</strong>
                    @request?.Customer?.FirstName
                    @request?.Customer?.LastName
                </p>

                <p><strong>Priority:</strong>
                    <span class="priority-@request?.Priority">
                        @request?.Priority
                    </span>
                </p>

                <p><strong>Details:</strong>
                    @request?.Details
                </p>

                <p class="mb-0">
                    <strong>Current Status:</strong>
                    <span class="badge bg-info ms-1">
                        @request?.Status
                    </span>
                </p>

            </div>
        </div>
    </div>


    <!-- UPDATE FORM -->
    <div class="col-md-4">
        <div class="card shadow-sm">

            <div class="card-header bg-primary text-white">
                <h6 class="mb-0">Update Status</h6>
            </div>

            <div class="card-body">

                <form method="post" action="/EmployeeService/UpdateServiceStatus">

                    <input type="hidden"
                           name="requestId"
                           value="@request?.RequestId" />

                    <div class="mb-3">

                        <label class="form-label fw-semibold">
                            Work Status *
                        </label>

                        <select name="workStatus"
                                class="form-select"
                                required>

                            <option value="">-- Select Status --</option>
                            <option value="Travelling">🚗 Travelling</option>
                            <option value="WorkStarted">🔧 Work Started</option>
                            <option value="Delayed">⏰ Delayed</option>
                            <option value="Paused">⏸ Paused</option>
                            <option value="Completed">✅ Completed</option>

                        </select>

                    </div>

                    <div class="mb-3">

                        <label class="form-label fw-semibold">
                            Notes
                        </label>

                        <textarea name="notes"
                                  class="form-control"
                                  rows="3"
                                  placeholder="Add notes about the work...">
                        </textarea>

                    </div>

                    <div class="d-flex gap-2">

                        <button type="submit"
                                class="btn btn-primary px-4">
                            <i class="bi bi-check-circle me-1"></i>
                            Update
                        </button>

                        <a href="/EmployeeService/AssignedServices"
                           class="btn btn-outline-secondary">
                            Back
                        </a>

                    </div>

                </form>

            </div>
        </div>
    </div>


    <!-- UPDATE HISTORY -->
    <div class="col-md-4">
        <div class="card shadow-sm">

            <div class="card-header bg-light">
                <h6 class="mb-0 fw-bold">
                    <i class="bi bi-clock-history me-1"></i>
                    Update History
                </h6>
            </div>

            <div class="card-body p-0">

                @if (workUpdates != null && workUpdates.Any())
                {
                    <ul class="list-group list-group-flush">

                        @foreach (var u in workUpdates)
                        {
                            <li class="list-group-item">

                                <div class="d-flex justify-content-between">

                                    <span class="badge bg-secondary">
                                        @u.WorkStatus
                                    </span>

                                    <small class="text-muted">
                                        @u.UpdateTime.ToString("MM/dd HH:mm")
                                    </small>

                                </div>

                                @if (!string.IsNullOrWhiteSpace(u.Notes))
                                {
                                    <p class="small text-muted mt-1 mb-0">
                                        @u.Notes
                                    </p>
                                }

                            </li>
                        }

                    </ul>
                }
                else
                {
                    <p class="text-muted text-center py-3 small">
                        No updates yet.
                    </p>
                }

            </div>
        </div>
    </div>

</div>