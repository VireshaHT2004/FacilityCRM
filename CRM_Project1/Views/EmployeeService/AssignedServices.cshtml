@model IEnumerable<CRM_Project.Models.ServiceAssignment>
@{
    ViewData["Title"] = "Assigned Jobs";
}

<div class="page-header">
    <h3><i class="bi bi-tools text-info me-2"></i>My Assigned Jobs</h3>
</div>

<div class="card">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Request #</th>
                        <th>Service</th>
                        <th>Customer</th>
                        <th>Location</th>
                        <th>Priority</th>
                        <th>Request Status</th>
                        <th>Your Status</th>
                        <th>Assigned</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var a in Model)
                    {
                        <tr>
                            <td>#@a.RequestId</td>
                            <td><strong>@a.Request?.Service?.ServiceName</strong></td>
                            <td>@a.Request?.Customer?.FirstName @a.Request?.Customer?.LastName</td>
                            <td>@a.Request?.Building?.BuildingName / Floor @a.Request?.FloorNumber</td>
                            <td><span class="priority-@a.Request?.Priority">@a.Request?.Priority</span></td>
                            <td><span class="badge badge-status-@a.Request?.Status text-white">@a.Request?.Status</span></td>
                            <td>
                                <span class="badge @(a.EmployeeStatus == "Accepted" ? "bg-success" : a.EmployeeStatus == "Rejected" ? "bg-danger" : "bg-secondary")">
                                    @a.EmployeeStatus
                                </span>
                            </td>
                            <td>@a.AssignedDate.ToString("MM/dd/yy")</td>
                            <td>
                                @if (a.EmployeeStatus == "Pending")
                                {
                                    <form method="post" action="/EmployeeService/RespondToAssignment" class="d-inline">
                                        <input type="hidden" name="assignmentId" value="@a.AssignmentId" />
                                        <input type="hidden" name="response" value="Accepted" />
                                        <button class="btn btn-sm btn-success">Accept</button>
                                    </form>
                                    <form method="post" action="/EmployeeService/RespondToAssignment" class="d-inline ms-1">
                                        <input type="hidden" name="assignmentId" value="@a.AssignmentId" />
                                        <input type="hidden" name="response" value="Rejected" />
                                        <button class="btn btn-sm btn-danger">Reject</button>
                                    </form>
                                }
                                @if (a.EmployeeStatus == "Accepted" && a.Request?.Status != "Completed")
                                {
                                    <button class="btn btn-sm btn-outline-primary" type="button" data-bs-toggle="collapse" data-bs-target="#updateForm-@a.RequestId" aria-expanded="false" aria-controls="updateForm-@a.RequestId">
                                        <i class="bi bi-arrow-up-circle"></i> Update
                                    </button>
                                }
                            </td>
                        </tr>
                        <tr class="collapse" id="updateForm-@a.RequestId">
                            <td colspan="9">
                                <div class="card card-body">
                                    <form method="post" action="/EmployeeService/UpdateServiceStatus">
                                        <input type="hidden" name="requestId" value="@a.RequestId" />
                                        <div class="row g-2 align-items-center">
                                            <div class="col-auto" style="min-width:220px;">
                                                <select name="workStatus" class="form-select form-select-sm" required>
                                                    <option value="">-- Select Status --</option>
                                                    <option value="Travelling">Travelling</option>
                                                    <option value="WorkStarted">Work Started</option>
                                                    <option value="Delayed">Delayed</option>
                                                    <option value="Paused">Paused</option>
                                                    <option value="Completed">Completed</option>
                                                </select>
                                            </div>
                                            <div class="col">
                                                <input name="notes" class="form-control form-control-sm" placeholder="Add notes (optional)" />
                                            </div>
                                            <div class="col-auto">
                                                <button class="btn btn-sm btn-primary">Save</button>
                                                <button type="button" class="btn btn-sm btn-outline-secondary ms-1" data-bs-toggle="collapse" data-bs-target="#updateForm-@a.RequestId">Close</button>
                                            </div>
                                        </div>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="9" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-1 d-block mb-2"></i>No jobs assigned yet.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
