@{
    ViewData["Title"] = "Assign Service";
    var request = ViewBag.Request as CRM_Project.Models.CustomerServiceRequest;
}

<div class="page-header">
    <h3><i class="bi bi-person-check text-primary me-2"></i>Assign Employee</h3>
</div>

<div class="row">
    <div class="col-md-5">
        <div class="card mb-3">
            <div class="card-header bg-light">
                <h6 class="mb-0 fw-bold">Request Details</h6>
            </div>
            <div class="card-body">
                <table class="table table-sm mb-0">
                    <tr>
                        <th class="text-muted small">Request ID</th>
                        <td>#@request?.RequestId</td>
                    </tr>
                    <tr>
                        <th class="text-muted small">Customer</th>
                        <td>@request?.Customer?.FirstName @request?.Customer?.LastName</td>
                    </tr>
                    <tr>
                        <th class="text-muted small">Building</th>
                        <td>@request?.Building?.BuildingName</td>
                    </tr>
                    <tr>
                        <th class="text-muted small">Floor</th>
                        <td>Floor @request?.FloorNumber</td>
                    </tr>
                    <tr>
                        <th class="text-muted small">Service</th>
                        <td>@request?.Service?.ServiceName</td>
                    </tr>
                    <tr>
                        <th class="text-muted small">Priority</th>
                        <td><span class="priority-@request?.Priority">@request?.Priority</span></td>
                    </tr>
                    <tr>
                        <th class="text-muted small">Details</th>
                        <td>@request?.Details</td>
                    </tr>
                </table>
            </div>
        </div>
    </div>
    <div class="col-md-5">
        <div class="card">
            <div class="card-header bg-primary text-white">
                <h6 class="mb-0">Assignment Form</h6>
            </div>
            <div class="card-body">
                <form method="post" action="/OwnerService/AssignService">
                    <input type="hidden" name="requestId" value="@request?.RequestId" />

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Select Employee *</label>
                        <select name="employeeId" class="form-select" required>
                            <option value="">-- Select Employee --</option>
                            @foreach (var item in (ViewBag.Employees as Microsoft.AspNetCore.Mvc.Rendering.SelectList ?? new Microsoft.AspNetCore.Mvc.Rendering.SelectList(new List<object>())))
                            {
                                <option value="@item.Value">@item.Text</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Estimated Cost ($)</label>
                        <input name="estimatedCost" class="form-control" type="number" step="0.01" placeholder="0.00" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Estimated Time</label>
                        <input name="estimatedTime" class="form-control" placeholder="e.g. 2 hours, 1 day" />
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary px-4">
                            <i class="bi bi-check-circle me-1"></i>Assign
                        </button>
                        <a href="/OwnerService/ServiceRequests" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
